<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>&#x1F339; ROSE FISH DATABASE &#x1F339;</title>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ROSE FISH DATABASE">
  <meta property="og:title" content="ROSE FISH DATABASE &#x1F339;">
  <meta property="og:description" content="The central archive for all FISH <>< COMMUNITY content — worlds, avatars, groups, 3D models, shaders, games, tools, sounds and more.">
  <meta property="og:image" content="https://raw.githubusercontent.com/FishStructuredChaos/database/main/images/ROSE_FISH_SPIN.gif">
  <meta property="og:url" content="https://database.theziver.com/">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="ROSE FISH DATABASE">
  <meta name="twitter:description" content="The central archive for all FISH <>< COMMUNITY content.">
  <meta name="twitter:image" content="https://raw.githubusercontent.com/FishStructuredChaos/database/main/images/ROSE_FISH_SPIN.gif">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>&#x1F339; ROSE &#xFF1C;&#xFF1E;&#xFF1C; DATABASE &#x1F339;</h1>
      <p>Archive for all FISH &lt;&gt;&lt; COMMUNITY content</p>
    </header>

    <div class="gsearch-wrap">
      <input id="gsearch" type="text" placeholder="&#x1F50D; SEARCH THE WHOLE DATABASE..." autocomplete="off">
      <div id="gsearch-results"></div>
    </div>

    <div class="submit-row">
      <a class="submit-badge" href="https://data.theziver.com/public" target="_blank">&#x1F517; SUBMIT TO DATABASE</a>
    </div>

    <div class="whats-new" id="whatsNew">
      <div class="wn-title">WHAT IS NEW?</div>
      <div class="wn-list">loading...</div>
    </div>

    <nav class="tab-nav" id="tab-nav">
      {% for tab in tabs %}
      {% if tab.type === 'section' %}
      <span class="tab-section">{{ tab.label | safe }}</span>
      {% else %}
      <button class="tab-btn" data-tab="{{ tab.id }}">{{ tab.label | safe }}</button>
      {% endif %}
      {% endfor %}
    </nav>

    <div id="tab-container">
      {{ content | safe }}
    </div>
  </div>

  <script src="js/tabs.js"></script>
  <button id="backTop" type="button" title="Back to top" aria-label="Back to top"></button>
</body>
</html>
